# Database (PostgreSQL)
DATABASE_URL="postgresql://clawpuzzle:your_secure_password@localhost:5432/clawpuzzle_dev"

# Redis Configuration
# Si REDIS_URL está definida manda ella y las variables sueltas se ignoran.
# En producción los proveedores gestionados dan un rediss:// (TLS obligatorio).
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT Configuration
JWT_ACCESS_SECRET="your-access-secret-key-here"
JWT_REFRESH_SECRET="your-refresh-secret-key-here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Configuration
# Orígenes permitidos por CORS. Admite varios separados por comas, con esquema y
# sin barra final:
#   FRONTEND_URL="https://clawpuzzle.com,https://staging.clawpuzzle.com"
# Solo sirve para hosts bajo el mismo dominio raíz que COOKIE_DOMAIN; desde
# fuera el CORS pasaría pero la cookie sameSite=lax no viajaría.
FRONTEND_URL="http://localhost:3000"

# Cookies de sesión.
# COOKIE_DOMAIN: déjalo vacío en local. En producción, con la API en
# api.clawpuzzle.com y el frontend en clawpuzzle.com, ponlo a ".clawpuzzle.com"
# para que la cookie viaje a ambos.
COOKIE_DOMAIN=""
# Solo si frontend y API acaban en dominios raíz distintos: "none" (exige HTTPS).
COOKIE_SAMESITE="lax"

# Google OAuth (same Client ID used by the frontend). The secret is only needed
# to exchange the auth code from the custom "Sign up" button (POST /auth/google/code).
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# AI Providers
FAL_KEY="fal-..."
# Optional: override the default VLM used by openrouter/router/vision (default: google/gemini-2.5-flash)
# OPENROUTER_DEFAULT_MODEL="google/gemini-2.5-flash"
# Skip fal.ai + OpenRouter calls during local testing — returns the pet photo as the "generated" image.
MOCK_AI=true
# Generaciones simultáneas del worker (1–10, por defecto 3). Limitado por la
# concurrencia que permite la cuenta de fal.ai y por la memoria de la instancia.
# IMAGE_GENERATION_CONCURRENCY=3

# Webhook Security
WEBHOOK_SECRET="generate-a-strong-random-secret-here"

# Application
PORT=3001
NODE_ENV="development"
# Swagger en /api/docs. Por defecto: encendido fuera de producción, apagado en
# producción (publica toda la superficie de la API sin credenciales).
# SWAGGER_ENABLED="false"

# Account lifecycle (AccountLifecycleService)
# Desactivado por defecto: con datos de desarrollo antiguos, el barrido daría de
# baja cuentas por sorpresa. Ponlo a "true" solo en producción.
ACCOUNT_LIFECYCLE_ENABLED="false"
# Meses sin iniciar sesión ni abrir sesión nueva antes de pasar a "inactive".
# La cuenta se reactiva sola en cuanto el usuario vuelve a entrar.
INACTIVITY_MONTHS="24"

# Imagen gratis sin login (sesiones de invitado, GuestAccountService)
# Interruptor. Apagado por defecto: se enciende cuando el frontend ya lo usa.
GUEST_GENERATION_ENABLED="false"
# Máximo de sesiones de invitado nuevas en las últimas 24 h (todas las IPs).
GUEST_DAILY_CAP="200"
# Días sin actividad antes de borrar a un invitado sin pedidos (fotos y arte
# incluidos). 0 desactiva la purga.
GUEST_RETENTION_DAYS="30"
# Vida de la sesión (refresh token) de un invitado.
GUEST_SESSION_DAYS="30"
# Secreto de Cloudflare Turnstile. Vacío = sin captcha (solo desarrollo).
TURNSTILE_SECRET_KEY=""

# Shopify Admin API (for product synchronization)
SHOPIFY_ADMIN_API_URL="https://puzzlesalvaje.myshopify.com/admin/api/2026-07"
SHOPIFY_ADMIN_API_TOKEN="shpat_xxxxxxxxxxxx"
SHOPIFY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
APP_PUBLIC_URL="https://api.clawpuzzle.com"

# Cuenta admin que crea `npm run seed` (login por password, no por Google).
# Sin estas dos variables el seed se salta el admin.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
