# Variables de Docker Compose (infraestructura). Copiar a deploy/.env.
# Usa contraseñas hexadecimales (`openssl rand -hex 32`): van dentro de URLs y
# un carácter como @ o / las rompería.

POSTGRES_USER=clawpuzzle
POSTGRES_PASSWORD=
POSTGRES_DB=clawpuzzle

REDIS_PASSWORD=

# Dominio que sirve Caddy. Su registro DNS debe apuntar ya a la IP del servidor
# para que Let's Encrypt emita el certificado. En local: localhost.
API_DOMAIN=api.clawpuzzle.com
# Email al que Let's Encrypt avisa si un certificado va a caducar.
ACME_EMAIL=

# Puertos publicados en el servidor. En local, si el 80/443 están ocupados:
# HTTP_PORT=8080 y HTTPS_PORT=8443.
HTTP_PORT=80
HTTPS_PORT=443
