# ─── Shopify (solo servidor) ───────────────────────────────────────────────
# Dominio de la tienda. Lo leen `lib/shopify/client.ts` y el route handler
# `app/api/shopify/proxy/route.ts` (el proxy que usa el cliente para no
# exponer el token en el navegador).
SHOPIFY_STORE_DOMAIN=https://your-store.myshopify.com
# Token de la Storefront API. NUNCA con prefijo NEXT_PUBLIC_.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token

# ─── Shopify (público) ─────────────────────────────────────────────────────
# Slug de la tienda en admin.shopify.com, para construir enlaces al admin de
# Shopify desde /admin (`entities/admin/lib/shopify-admin-url.ts`).
NEXT_PUBLIC_SHOPIFY_STORE_SLUG=your-store

# ─── Backend ───────────────────────────────────────────────────────────────
# URL base de la API de NestJS, incluido el prefijo /api.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── Google OAuth ──────────────────────────────────────────────────────────
# Client ID de tipo "Web application"; mismo valor que GOOGLE_CLIENT_ID en el
# backend. Lo consume `app/layout.tsx`.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ─── Modo lanzamiento ──────────────────────────────────────────────────────
# "true" reduce el sitio al embudo de lanzamiento (landing + IA + oferta de
# puzzle) y bloquea las rutas de tienda. Cualquier otro valor = tienda
# completa. Ver `shared/config/launch.ts` y la sección "Launch Mode" de
# CLAUDE.md. Se inlinea en build: cambiarlo exige redeploy.
NEXT_PUBLIC_LAUNCH_MODE=false

# ─── SEO ────────────────────────────────────────────────────────────────────
# Origin público usado por canonical, Open Graph, robots.txt y sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://clawpuzzle.com
